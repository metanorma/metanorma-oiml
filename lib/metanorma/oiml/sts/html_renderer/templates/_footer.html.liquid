<div class="footer-grid">
  <div class="footer-block">
    <p class="footer-license">
      {% if copyright %}{{ copyright | escape }} · {{ license | escape }}{% else %}{{ license | escape }}{% endif %}
    </p>
    <p class="footer-publisher">{{ publisher_name | escape }}</p>
    <p class="footer-address">{{ publisher_address | escape }}</p>
    <p class="footer-contact">
      <a href="https://www.oiml.org">www.oiml.org</a> ·
      <a href="mailto:biml@oiml.org">biml@oiml.org</a>
    </p>
  </div>
  <div class="footer-block footer-meta">
    <p><span class="footer-docid">{{ docid | escape }}</span></p>
    <p>{% if series != "" %}Series {{ series | escape }} · {% endif %}{% if year != "" %}{{ year | escape }} · {% endif %}EN</p>
    <p class="footer-generated">Generated by metanorma-oiml · Liquid STS renderer · Tailwind 4</p>
  </div>
</div>
