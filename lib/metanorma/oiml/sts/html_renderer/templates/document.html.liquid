<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title | escape }}</title>
<style>
{{ css }}
</style>
</head>
<body>
<header class="site-brand">
  <span class="brand-logo">{{ logo }}</span>
  <span class="brand-text">
    <span class="doc-id">{{ docid | escape }}</span>
    <span class="doc-title">{{ title | escape }}</span>
  </span>
  <button id="toc-toggle" class="toc-toggle" aria-label="Show contents" aria-expanded="false" aria-controls="toc">☰</button>
</header>
<div class="page">
  {{ toc }}
  {{ content }}
</div>
<button id="back-to-top" class="back-to-top" aria-label="Back to top" title="Back to top">↑</button>
<footer class="site-footer">
  <span>Generated by metanorma-oiml · Liquid STS renderer</span>
</footer>
<script>
{{ js }}
</script>
</body>
</html>
